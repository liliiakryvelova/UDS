# Recommended free option (Neon)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/uds_events?sslmode=require&channel_binding=require"

# Local Postgres fallback
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uds_events?schema=public"

# Admin login (change before production)
ADMIN_EMAIL="admin@uds.local"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-long-random-secret"

# Optional: separate secret for volunteer user sessions
# If omitted, app uses ADMIN_SESSION_SECRET
USER_SESSION_SECRET="replace-with-long-random-secret"

# Optional: base URL used in password reset emails (recommended in production)
# APP_ORIGIN="https://your-app-domain.com"

# Optional: Resend email provider for password reset delivery
# RESEND_API_KEY="re_..."
# RESET_FROM_EMAIL="UDS Events <no-reply@yourdomain.com>"
