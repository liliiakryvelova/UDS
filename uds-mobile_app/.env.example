# Existing UDS Events API origin. Keep the production origin unless using an authorized staging deployment.
UDS_API_BASE_URL=https://events.ukrainedefensesupport.org
NEXT_PUBLIC_UDS_WEB_URL=https://events.ukrainedefensesupport.org

# Local development is read-only by default. Set true only when using an authorized staging backend.
# UDS_ALLOW_API_WRITES=true

# Optional: initial community ID shown in admin event creation when the account has no existing events.
# NEXT_PUBLIC_UDS_COMMUNITY_ID=
